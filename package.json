{
  "name": "note-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "concurrently -k -n SERVER,REACT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
